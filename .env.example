# CaseConnect — Environment Configuration Template
# Copy this file to .env or backend/.env and replace placeholders

PORT=5000
NODE_ENV=production
FRONTEND_URL=*

# Supabase Transaction Pooler URL (recommended and sufficient by itself)
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Supabase Database Settings > SSL Configuration > Download Certificate.
# Set PGSSL_CA_CERT to the PEM contents (Vercel) or PGSSL_CA_CERT_PATH to a local file.
# The repository also ships backend/certs/supabase-prod-ca-2021.crt for verified TLS.
PGSSL_CA_CERT=
PGSSL_CA_CERT_PATH=backend/certs/supabase-prod-ca-2021.crt
# Local-only diagnostic override. Never set this in production.
# PGSSL_REJECT_UNAUTHORIZED=false

# Application Security (generate a unique random value of at least 32 bytes)
JWT_SECRET=your_strong_random_jwt_secret_key_min_32_characters
SESSION_EXPIRY=12h
