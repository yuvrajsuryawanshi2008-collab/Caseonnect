# CaseConnect MongoDB Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=*

# MongoDB Connection String
# For local MongoDB Campus: mongodb://127.0.0.1:27017/caseconnect
# For remote MongoDB Campus cluster: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/caseconnect?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/caseconnect

# Security Secrets
JWT_SECRET=caseconnect_production_jwt_secret_key_2026_regulatory
SESSION_EXPIRY=12h
