# CaseConnect backend environment
PORT=5000
NODE_ENV=production
FRONTEND_URL=*

# Supabase Transaction Pooler connection string
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# Set a unique random secret of at least 32 characters
JWT_SECRET=replace_with_a_unique_random_secret_of_at_least_32_characters
SESSION_EXPIRY=12h

# Optional local CA bundle path. Vercel can use PGSSL_CA_CERT with PEM contents.
PGSSL_CA_CERT_PATH=backend/certs/supabase-prod-ca-2021.crt
PGSSL_CA_CERT=
